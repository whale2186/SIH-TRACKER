# Render API URL (your deployed app)
RENDER_API_URL=https://your-app.onrender.com

# Secret key - must match SYNC_API_KEY in Render's environment variables
# Generate a strong random string: openssl rand -hex 32
SYNC_API_KEY=your-super-secret-key-here

# How often to sync (in hours)
SYNC_INTERVAL_HOURS=6